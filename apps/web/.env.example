# AIOS Web Environment Configuration
# Non-secret Vite variables for the web app.
# VITE_TBIT_API_KEY is NOT listed here: it is generated automatically into the
# repository-root `.env` by `pnpm run setup:secret` and served to the frontend
# via Vite's envDir (repo root). Do NOT put a manual copy of the key here.

# API Base URL (used by Vite at build time and runtime)
# In Docker, the API is at http://localhost:3001
# In development with Vite proxy, this points to the dev server
# Production: VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:3001

# Optional: Enable debug logging
# VITE_DEBUG=false
