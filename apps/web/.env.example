# AIOS Web Environment Configuration
# Copy to .env and customize for your environment

# API Base URL (used by Vite at build time and runtime)
# In Docker, the API is at http://localhost:3001
# In development with Vite proxy, this points to the dev server
VITE_API_BASE_URL=http://localhost:3001

# Optional: Enable debug logging
# VITE_DEBUG=false
