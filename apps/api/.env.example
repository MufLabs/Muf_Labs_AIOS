# AIOS API Environment Configuration
# Non-secret runtime configuration. Secret T-Bit variables are NOT listed here:
# they are generated automatically into the repository-root `.env` by
#   pnpm run setup:secret
# and are consumed from there (apps/api loads ../../.env).

# Application
NODE_ENV=production
PORT=3001

# T-Bit Data Directory (persistent volume)
TBIT_VAULT_ROOT=/data/spaces

# CORS - comma-separated list of allowed origins (explicit allowlist takes precedence)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Logging
LOG_LEVEL=info

# Metrics endpoint (opt-in)
ENABLE_METRICS=true

# Secrets (generated by pnpm run setup:secret into root .env):
# TBIT_API_KEY=<generated>
# TBIT_HMAC_SECRET=<generated>
# TBIT_ENCRYPTION_SECRET=<generated>
