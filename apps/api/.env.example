# AIOS API Environment Configuration
# Copy to .env and customize for your environment

# Application
NODE_ENV=production
PORT=3001

# T-Bit Data Directory (persistent volume)
TBIT_VAULT_ROOT=/data/spaces

# CORS - comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Symbolic API Key for T-Bit endpoints
# IMPORTANT: Change this in production!
SYMBOLIC_API_KEY=changeme

# Logging
LOG_LEVEL=info
