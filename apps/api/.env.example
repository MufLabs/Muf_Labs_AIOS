# AIOS API Environment Configuration
# Non-secret runtime configuration. Secret T-Bit variables are NOT listed here:
# they are generated automatically into the repository-root `.env` by
#   pnpm run setup:secret
# and are consumed from there (apps/api loads ../../.env).

# Application
NODE_ENV=production
PORT=3001

# T-Bit Data Directory (persistent volume)
TBIT_VAULT_ROOT=/data/spaces

# CORS - comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
