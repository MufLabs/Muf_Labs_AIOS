{
  "name": "aios",
  "version": "0.5.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "setup:secret": "node scripts/setup-tbit-secret.mjs",
    "build": "turbo run build",
    "dev": "node scripts/setup-tbit-secret.mjs && turbo run dev --filter=@aios/api --filter=@aios/web",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:secret": "vitest run --config vitest.config.ts tests/setup-tbit-secret.test.ts",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "test:coverage": "turbo run test:coverage"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/three": "^0.185.1",
    "@vitest/coverage-v8": "^1.6.1",
    "resize-observer-polyfill": "^1.5.1",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3",
    "undici": "^6.19.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "three": "^0.185.1"
  }
}
