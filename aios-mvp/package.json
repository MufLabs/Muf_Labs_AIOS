{
  "name": "aios-mvp",
  "version": "0.1.0",
  "description": "MufLabs AIOS MVP - Core Loop Implementation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "knex migrate:latest --knexfile migrations/knexfile.ts",
    "migrate:make": "knex migrate:make --knexfile migrations/knexfile.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "knex": "^3.1.0",
    "pino": "^9.0.0",
    "sql.js": "^1.14.1",
    "uuid": "^9.0.0",
    "@aios/database": "workspace:*",
    "@aios/agents": "workspace:*",
    "@aios/llm": "workspace:*",
    "@aios/kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.7",
    "knex-types": "^0.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
