{
    "name": "@aios/workflow",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@aios/kernel": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^24.3.0",
        "@vitest/coverage-v8": "^1.6.1",
        "typescript": "^5.9.3",
        "vitest": "^1.6.1"
    }
}
